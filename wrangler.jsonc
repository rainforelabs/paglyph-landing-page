{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "paglyph-landing-page",
  "account_id": "b43b5e6d945a101ed5c490ace6ed2d0f",
  "compatibility_date": "2026-11-03",
  // paglyph.app is redirected to www by a Cloudflare Redirect Rule, which runs before the Worker.
  "routes": [
    { "pattern": "www.paglyph.app", "custom_domain": true },
    { "pattern": "paglyph.app", "custom_domain": true }
  ],
  // Static assets only: Astro prerenders every page, so there is no Worker script.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
