---
import Layout from './Layout.astro';
import Footer from '../components/Footer.astro';
interface Props { title?: string; description?: string; frontmatter?: { title: string; description: string }; }
const { frontmatter, title, description } = Astro.props;
---
<Layout title={title || frontmatter?.title} description={description || frontmatter?.description}>
  <main class="document" id="main" tabindex="-1"><slot /></main>
  <Footer />
</Layout>
