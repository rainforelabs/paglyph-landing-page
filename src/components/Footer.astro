---
import { site } from '../config';
interface Props { oversized?: boolean; }
const { oversized = false } = Astro.props;
---
<footer class:list={['site-footer', { 'site-footer--oversized': oversized }]}>
  <div class="container footer-content">
    <div class="footer-rule" aria-hidden="true"><img src="/images/figma/footer-line.svg" width="1080" height="1" alt="" loading="lazy" /></div>
    <div class="footer-row">
      <p>© {new Date().getFullYear()} Paglyph. All rights reserved.</p>
      <nav class="footer-links" aria-label="Legal and support">
        <a href="/privacy/">Privacy</a>
        <a href={site.termsUrl}>Terms</a>
        <a href={`mailto:${site.supportEmail}`}>Support</a>
      </nav>
    </div>
  </div>
  {oversized && <div class="container footer-art" aria-hidden="true"><img src="/images/figma/footer-wordmark.svg" width="1228.18" height="237.558" alt="" loading="lazy" /></div>}
</footer>
