---
const icons = [
  { name: 'Primary', variant: 'primary', file: 'app-icon-primary.svg', width: 57.8116, height: 57.009 },
  { name: 'Grayscale', variant: 'grayscale', file: 'app-icon-grayscale.svg', width: 57.8121, height: 57.0088 },
  { name: 'Mono', variant: 'mono', file: 'app-icon-mono.svg', width: 57.8121, height: 57.0088 },
  { name: 'Paper', variant: 'paper', file: 'app-icon-paper-texture.webp', width: 78.375, height: 78.375 },
];
---
<div class="closing-mark">
  <button class="icon-sequence" type="button" aria-label="Paglyph app icons" title="Cycle app icons" disabled>
    {icons.map((icon, index) => (
      <span class={`app-icon-option app-icon-option--${icon.variant}`} data-active={index === 0 ? 'true' : 'false'} data-icon-name={icon.name} aria-hidden="true">
        <span class="app-icon-brand">
          <img src={`/images/figma/${icon.file}`} width={icon.width} height={icon.height} alt="" loading="lazy" decoding="async" />
        </span>
      </span>
    ))}
  </button>
</div>

<script>
  import '../scripts/app-icon-sequence';
</script>

<style>
  .closing-mark { width: 112px; height: 112px; }
  .icon-sequence { position: relative; display: grid; place-items: center; width: 112px; height: 112px; padding: 8px; border: 0; border-radius: 32px; background: none; cursor: pointer; -webkit-tap-highlight-color: transparent; transition: transform var(--motion-fast) var(--ease-out); }
  .icon-sequence:disabled { cursor: default; }
  .app-icon-option { position: relative; grid-area: 1 / 1; display: block; width: 96px; height: 96px; overflow: hidden; border-radius: 24px; visibility: hidden; background: #f5f5f5; box-shadow: var(--icon-glass-shadow); pointer-events: none; user-select: none; }
  @supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .app-icon-option { background: var(--icon-glass-fill); -webkit-backdrop-filter: blur(16px) saturate(1.35); backdrop-filter: blur(16px) saturate(1.35); }
  }
  .app-icon-option[data-active='true'] { visibility: visible; }
  .app-icon-brand { position: absolute; left: 13.13px; top: 13.5px; width: 69.375px; height: 69.375px; overflow: hidden; border-radius: 17.344px; }
  .app-icon-brand img { position: absolute; left: 5.7815px; top: 5.783px; }
  .app-icon-option--mono img { left: 5.78px; top: 5.78px; }
  .app-icon-option--paper .app-icon-brand { top: 13.13px; }
  .app-icon-option--paper img { left: -7.13px; top: -7.13px; object-fit: cover; mask: url('/images/figma/app-icon-paper-mask.svg') 12.906px 13.467px / 57.607px 56.447px no-repeat; }
  .icon-sequence[data-playing] .app-icon-option[data-active='true'] { will-change: transform; animation: icon-pop 420ms cubic-bezier(.22, 1, .36, 1); }
  .icon-sequence[data-settling] .app-icon-option[data-active='true'] { will-change: transform; animation: icon-land 620ms cubic-bezier(.22, 1, .36, 1); }
  @keyframes icon-pop {
    from { transform: scale(1.04); }
    to { transform: scale(1); }
  }
  @keyframes icon-land {
    from { transform: scale(1.06); }
    to { transform: scale(1); }
  }
  .icon-sequence:not(:disabled):active { transform: scale(.96); }
  :global(:root[data-input='keyboard']) .icon-sequence,
  :global(:root[data-input='keyboard']) .app-icon-option { animation: none; transition: none; }
  :global(:root[data-input='keyboard']) .icon-sequence { transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .icon-sequence, .app-icon-option { animation: none; transition: none; }
    .icon-sequence:not(:disabled):active { transform: none; }
  }
  @media (prefers-reduced-transparency: reduce), (prefers-contrast: more) {
    .app-icon-option { background: #fafafa; -webkit-backdrop-filter: none; backdrop-filter: none; box-shadow: 0 0 0 1px rgb(0 0 0 / .2), 0 4px 12px -6px rgb(0 0 0 / .12); }
  }
  @media (forced-colors: active) {
    .app-icon-option { background: Canvas; border: 1px solid ButtonText; -webkit-backdrop-filter: none; backdrop-filter: none; box-shadow: none; }
  }
  @media print {
    .icon-sequence, .app-icon-option { animation: none; transition: none; }
    .icon-sequence { transform: none; }
    .app-icon-option { background: #fafafa; -webkit-backdrop-filter: none; backdrop-filter: none; box-shadow: 0 0 0 1px rgb(0 0 0 / .15); }
  }
</style>
